---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** Keep 404 and other utility pages out of search results. */
  noindex?: boolean;
  /** Share image (jpg/png only). Root-relative with the base path already applied, or absolute. */
  image?: string;
  /** Structured data (schema.org) rendered as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Itai Lior // Software & Jazz: apps, Chrome extensions and games",
  description = "Apps, a Chrome extension and games by Itai Lior — each one explained, all built by one maker. Plus remote backend, MVP and browser-extension contracts.",
  noindex = false,
  image,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image && /\.(jpe?g|png|webp)$/i.test(image) ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-style="sketch">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the saved site style before first paint (no flash). Default: sketch. -->
    <script is:inline>
      (function () {
        var styles = { poster: "#0e0d0c", workshop: "#1c140e", sketch: "#1f2530" };
        var s = "sketch";
        try {
          var saved = localStorage.getItem("il-style");
          if (saved && styles[saved]) s = saved;
        } catch (e) {}
        document.documentElement.dataset.style = s;
        window.__IL_STYLES = styles;
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f2530" />
    <meta name="author" content="Itai Lior" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Itai Lior // Software & Jazz" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- One request for all three styles; browsers only download the faces a page actually uses. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Bebas+Neue&family=JetBrains+Mono:wght@400;500&family=Kalam:wght@400;700&family=Nunito:wght@400;600;700;800&family=Oswald:wght@500;600;700&family=Playfair+Display:ital,wght@1,600;1,700;1,900&family=Roboto+Slab:wght@600;700&family=Rubik:wght@500;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-clip">
    <slot />
  </body>
</html>
