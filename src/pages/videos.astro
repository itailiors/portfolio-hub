---
/** Videos: the two studio YouTube channels with their latest uploads (fetched at build time). */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sections/Nav.astro";
import SiteFooter from "../components/hub/SiteFooter.astro";
import ChannelCard from "../components/hub/ChannelCard.astro";
import VideoCard from "../components/hub/VideoCard.astro";
import VideoScript from "../components/hub/VideoScript.astro";
import { channels, getVideos } from "../lib/youtube";

const videos = await getVideos();
const EMPTY: Record<string, string> = {
  apps: "New demos and walkthroughs are on the way. Subscribe to catch them first.",
  games: "The Bet on Dave series and the first dev vlogs are coming soon. Subscribe so you don't miss episode one.",
};
---

<Layout title="Videos — Itai Lior // Software & Jazz" description="Demos, shorts, the Bet on Dave series and dev vlogs from the Infilimit Applications and Infilimit Games YouTube channels.">
  <Nav active="videos" />
  <main class="mx-auto max-w-6xl px-4 pt-32 sm:px-6 sm:pt-28">
    <p class="eyebrow">Videos</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] tracking-wide sm:text-6xl">Watch them in action.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cream-muted">
      Two channels: one for the apps and extensions, one for the games. Demos, shorts, the Bet on Dave series and dev vlogs.
    </p>

    {
      channels.map((c) => (
        <section class="mt-16" aria-labelledby={`ch-${c.id}`}>
          <h2 id={`ch-${c.id}`} class="sr-only">
            {c.name}
          </h2>
          <ChannelCard channel={c} note={videos[c.id].length ? undefined : EMPTY[c.id]} />
          {videos[c.id].length > 0 && (
            <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {videos[c.id].map((v) => (
                <li>
                  <VideoCard video={v} />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </main>
  <SiteFooter />
  <VideoScript />
</Layout>
