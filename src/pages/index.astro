---
/**
 * Products hub — the homepage. Products first; everything about the maker lives on /about/.
 * Structure is shared by all three site styles (Poster · Workshop · Sketch); see styles.css.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sections/Nav.astro";
import ProductCard from "../components/hub/ProductCard.astro";
import SiteFooter from "../components/hub/SiteFooter.astro";
import profile from "../data/profile.json";
import { HUB_FILTERS, hubStats, products } from "../lib/products";
import { withBase } from "../lib/url";
import VideoCard from "../components/hub/VideoCard.astro";
import VideoScript from "../components/hub/VideoScript.astro";
import { channels, getVideos } from "../lib/youtube";

const feeds = await getVideos();
const latest = [...feeds.apps, ...feeds.games].sort((a, b) => b.published.localeCompare(a.published)).slice(0, 3);
const jams = profile.creative.gameJams;
const stats = hubStats(jams.length);
const siteUrl = new URL(withBase("/"), Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Itai Lior // Software & Jazz",
    url: siteUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Itai Lior",
    url: siteUrl,
    jobTitle: "Full-stack product engineer",
    sameAs: ["https://github.com/itailiors"],
  },
];
---

<Layout jsonLd={jsonLd}>
  <Nav active="products" />
  <main class="mx-auto max-w-7xl px-4 pt-32 sm:px-6 sm:pt-28">
    <section aria-labelledby="hub-title" class="max-w-3xl">
      <p class="eyebrow">Itai Lior // Software &amp; Jazz</p>
      <h1 id="hub-title" class="mt-3 font-display text-5xl leading-[0.95] tracking-wide sm:text-6xl lg:text-7xl">
        Apps, tools &amp; games, <span class="font-serif italic text-terra">made by hand.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cream-muted">
        A small studio of one. Every product below is explained: what it does, who it's for and how it works. Open any of them for the full story.
      </p>
    </section>

    <!-- stats strip + filters -->
    <div class="mt-10 flex flex-col gap-6 border-y border-cream/15 py-4 lg:flex-row lg:items-center lg:justify-between">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-3 sm:flex sm:flex-wrap">
        {
          stats.map((s) => (
            <div class="flex items-baseline gap-2">
              <dt class="sr-only">{s.label}</dt>
              <dd class="numeral text-4xl">{s.value}</dd>
              <dd class="text-sm text-cream-muted" aria-hidden="true">{s.label}</dd>
            </div>
          ))
        }
      </dl>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter products" data-hub-filters>
        {
          HUB_FILTERS.map((f) => (
            <button type="button" class="hub-chip" data-filter={f.id} aria-pressed={f.id === "all" ? "true" : "false"}>
              {f.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- bento -->
    <section aria-label="Products" class="hub-grid mt-14 grid gap-x-8 gap-y-12 md:grid-cols-2 xl:grid-cols-12" data-hub-grid>
      {products.map((p, i) => <ProductCard product={p} eager={i === 0} />)}
    </section>
    <p class="mt-8 hidden text-center text-cream-muted" data-hub-empty>Nothing in this category yet.</p>

    <!-- latest videos from both studio channels -->
    <section aria-labelledby="videos-title" class="mt-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">On YouTube</p>
          <h2 id="videos-title" class="mt-2 font-display text-4xl tracking-wide sm:text-5xl">See them in action</h2>
        </div>
        <a href={withBase("/videos/")} class="btn-ghost px-4 py-2 text-sm">All videos →</a>
      </div>
      {
        latest.length > 0 && (
          <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {latest.map((v) => (
              <li>
                <VideoCard video={v} />
              </li>
            ))}
          </ul>
        )
      }
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {
          channels.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="hub-panel group block h-full">
                <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-terra">{c.handle}</p>
                <p class="mt-1 font-display text-2xl tracking-wide group-hover:text-terra">{c.name} ↗</p>
                <p class="mt-1 text-sm text-cream-muted">{c.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- more from the studio: inkle-style list -->
    <section aria-labelledby="more-title" class="mt-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Off the main stage</p>
          <h2 id="more-title" class="mt-2 font-display text-4xl tracking-wide sm:text-5xl">Jam builds &amp; experiments</h2>
        </div>
        <a href={withBase("/archive/")} class="btn-ghost px-4 py-2 text-sm">Open the archive →</a>
      </div>
      <ul class="mt-8 divide-y divide-cream/15 border-y border-cream/15">
        {
          jams.map((j) => (
            <li class="grid gap-2 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6">
              <div class="min-w-0">
                <a href={j.url} target="_blank" rel="noopener noreferrer" class="font-display text-2xl tracking-wide hover:text-terra">
                  {j.title} <span aria-hidden="true">↗</span>
                </a>
                <p class="mt-1 text-cream-muted">
                  Made for {j.jam}. {j.note}.
                </p>
              </div>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-cream-subtle">Game jam · itch.io</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <SiteFooter />
  <VideoScript />
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>("[data-hub-filters]");
  const grid = document.querySelector<HTMLElement>("[data-hub-grid]");
  const empty = document.querySelector<HTMLElement>("[data-hub-empty]");
  bar?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
    if (!btn || !grid) return;
    const f = btn.dataset.filter!;
    bar.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    let shown = 0;
    grid.querySelectorAll<HTMLElement>(".hub-card").forEach((card) => {
      const match = f === "all" || (card.dataset.filters ?? "").split(" ").includes(f);
      card.hidden = !match;
      if (match) shown++;
    });
    if (f === "all") delete grid.dataset.filtered;
    else grid.dataset.filtered = f;
    empty?.classList.toggle("hidden", shown > 0);
  });
</script>
