---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sections/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import PosterSection from "../components/sections/PosterSection.astro";
import Experience from "../components/sections/Experience.astro";
import CreativeLab from "../components/sections/CreativeLab.astro";
import Hire from "../components/sections/Hire.astro";
import ProductShowcase from "../components/ProductShowcase";
import DrawerPreview from "../components/DrawerPreview";
import ecosystemJson from "../../public/ecosystem.json";
import type { EcosystemManifest } from "../types/ecosystem";
import { withBase } from "../lib/url";

import { existsSync } from "node:fs";
import { join } from "node:path";

// Single source of truth: the same file external apps fetch at /ecosystem.json
const manifest = ecosystemJson as EcosystemManifest;

// Build-time check: drop local imageUrls whose file isn't in /public yet, so the page
// doesn't request missing screenshots. Remote URLs (and any image that fails at
// runtime) are still covered by the client-side onError fallback in ProductShowcase.
// Local paths that do exist get the deploy base path (e.g. /portfolio-hub) prepended.
const isLocal = (url?: string): url is string => !!url && url.startsWith("/");
const resolveImage = (url?: string) => {
  if (!isLocal(url)) return url;
  return existsSync(join(process.cwd(), "public", url)) ? withBase(url) : undefined;
};
const ecosystem: EcosystemManifest = {
  ...manifest,
  products: manifest.products.map((p) => ({ ...p, imageUrl: resolveImage(p.imageUrl) })),
};
---

<Layout>
  <Nav />
  <main>
    <Hero />

    <PosterSection
      id="products"
      number="01"
      rail="Live Products"
      eyebrow="Product ecosystem"
      title="Things I've shipped (and am shipping)."
      subtitle="Flip any card to ⚙️ Under the Hood to see how it's built — or try it as a user first."
    >
      <div class="mt-10">
        <ProductShowcase client:load manifest={ecosystem} />
      </div>
    </PosterSection>

    <Experience />
    <CreativeLab />

    <PosterSection
      id="widget"
      eyebrow="Drop-in widget"
      title="One manifest. Every app cross-promotes the rest."
      subtitle="This is the exact “More tools by me” drawer embedded in my Chrome extension and mobile app — a portable React component fed by a public JSON manifest."
      class="border-t border-cream/10"
    >
      <div class="mt-12">
        <DrawerPreview client:visible manifest={ecosystem} />
      </div>
    </PosterSection>

    <Hire />
  </main>
</Layout>
