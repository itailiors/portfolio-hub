---
/** Archive: game-jam builds and recorded sessions — the side projects off the main stage. */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/sections/Nav.astro";
import SiteFooter from "../components/hub/SiteFooter.astro";
import profile from "../data/profile.json";
import { withBase } from "../lib/url";

const { gameJams, sessions } = profile.creative;
---

<Layout title="Archive — Itai Lior // Software & Jazz" description="Game-jam builds and recorded music sessions by Itai Lior.">
  <Nav active="archive" />
  <main class="mx-auto max-w-5xl px-4 pt-32 sm:px-6 sm:pt-28">
    <p class="eyebrow">Archive</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] tracking-wide sm:text-6xl">Off the main stage.</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cream-muted">
      Game-jam builds made with friends against the clock, and recorded music sessions. Smaller than the products, but every one of them shipped.
    </p>

    <section class="mt-14" aria-labelledby="jams">
      <h2 id="jams" class="font-display text-3xl tracking-wide sm:text-4xl">Game jams</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2">
        {
          gameJams.map((j) => (
            <li class="hub-panel flex flex-col">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-terra">{j.jam}</p>
              <h3 class="mt-2 font-display text-3xl leading-none tracking-wide">{j.title}</h3>
              <p class="mt-2 text-cream-muted">{j.note}. Playable in the browser on itch.io.</p>
              <div class="mt-auto flex flex-wrap gap-3 pt-6">
                <a href={j.url} target="_blank" rel="noopener noreferrer" class="btn-crimson px-4 py-2 text-sm">
                  Play on itch.io ↗
                </a>
                {"soundtrack" in j && j.soundtrack && (
                  <a href={j.soundtrack} target="_blank" rel="noopener noreferrer" class="btn-ghost px-4 py-2 text-sm">
                    Soundtrack ▶
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="tapes">
      <h2 id="tapes" class="font-display text-3xl tracking-wide sm:text-4xl">Session tapes</h2>
      <ul class="mt-6 divide-y divide-cream/15 border-y border-cream/15">
        {
          sessions.map((s) => (
            <li class="flex flex-wrap items-center justify-between gap-3 py-4">
              <div>
                <p class="font-display text-2xl tracking-wide">{s.title}</p>
                <p class="text-sm text-cream-muted">{s.note}</p>
              </div>
              <a
                href={`https://www.youtube.com/watch?v=${s.youtubeId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost px-4 py-2 text-sm"
              >
                Watch on YouTube ↗
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-cream-muted">
        More about the music on the <a href={withBase("/about/#lab")} class="font-semibold text-cream underline decoration-terra decoration-2 underline-offset-4">About &amp; Jazz</a> page.
      </p>
    </section>
  </main>
  <SiteFooter />
</Layout>
