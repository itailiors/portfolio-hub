---
import profile from "../../data/profile.json";
import SectionHeader from "./SectionHeader.astro";

const icons: Record<string, string> = {
  server:
    '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  rocket:
    '<path d="M14.5 4.5c3-1 5 1 5 1s2 2 1 5l-6 6-6-6 6-6Z"/><circle cx="15" cy="9" r="1.5"/><path d="M8.5 11.5 5 12l-2 3 4 .5M12.5 15.5 12 19l-3 2-.5-4"/>',
  puzzle:
    '<path d="M9 3h4v3a2 2 0 1 0 4 0V3h4v6h-3a2 2 0 1 0 0 4h3v8h-6v-3a2 2 0 1 0-4 0v3H3v-6h3a2 2 0 1 0 0-4H3V3h6Z"/>',
};
---

<section id="experience" class="relative py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader
      eyebrow="Engineering track record"
      title="Built at scale. Shipped end-to-end."
      subtitle="Production backends at eBay, open-source protocol work at Angor.io, and three years building full-stack systems and automation in the military."
    />

    <ol class="relative mt-12 space-y-6 border-l border-white/10 pl-6 sm:pl-8">
      {
        profile.experience.map((job) => (
          <li class="relative">
            <span
              class="absolute -left-[31px] top-6 h-3 w-3 rounded-full border-2 border-ink-950 bg-brand ring-4 ring-brand/15 sm:-left-[39px]"
              aria-hidden="true"
            />
            <div class="glass glass-hover rounded-2xl p-6">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-lg font-semibold">
                  {job.role} <span class="text-fg-subtle">·</span> <span class="text-brand">{job.company}</span>
                </h3>
                <p class="font-mono text-xs text-fg-subtle">
                  {job.period} · {job.location}
                </p>
              </div>
              <p class="mt-2 text-sm text-fg-muted">{job.summary}</p>
              <ul class="mt-4 space-y-1.5 text-sm text-fg-muted">
                {job.highlights.map((h) => (
                  <li class="flex gap-2">
                    <span class="text-accent" aria-hidden="true">
                      ▹
                    </span>
                    {h}
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {job.stack.map((t) => (
                  <span class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5 font-mono text-[11px] text-fg-muted">{t}</span>
                ))}
              </div>
            </div>
          </li>
        ))
      }
      {
        profile.education.map((ed) => (
          <li class="relative">
            <span
              class="absolute -left-[31px] top-5 h-3 w-3 rounded-full border-2 border-ink-950 bg-accent sm:-left-[39px]"
              aria-hidden="true"
            />
            <div class="rounded-2xl border border-dashed border-white/10 p-5">
              <h3 class="font-semibold">
                {ed.degree} <span class="text-fg-subtle">· {ed.institution}</span>
              </h3>
              <p class="mt-1 font-mono text-xs text-fg-subtle">{ed.period}</p>
              <p class="mt-2 text-sm text-fg-muted">{ed.notes}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="services" class="relative py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader
      eyebrow="Work with me"
      title="Productized remote services."
      subtitle="Fixed-scope engagements for founders and teams who need senior hands without the hiring cycle."
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        profile.services.map((svc, i) => (
          <div class="glass glass-hover flex flex-col rounded-2xl p-6">
            <div class="flex items-center justify-between">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand/10 text-brand ring-1 ring-brand/25">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icons[svc.icon] ?? ""}
                />
              </span>
              <span class="font-mono text-xs text-fg-subtle">0{i + 1}</span>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{svc.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{svc.description}</p>
            <ul class="mt-5 space-y-2 border-t border-white/5 pt-5 text-sm">
              {svc.deliverables.map((d) => (
                <li class="flex gap-2 text-fg-muted">
                  <span class="text-accent" aria-hidden="true">
                    ✓
                  </span>
                  {d}
                </li>
              ))}
            </ul>
            <a href="#hire" class="mt-auto pt-6 text-sm font-semibold text-fg transition hover:text-brand">
              Start a project →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
