---
import profile from "../../data/profile.json";
import PosterSection from "./PosterSection.astro";

const icons: Record<string, string> = {
  server:
    '<rect x="3" y="4" width="18" height="7"/><rect x="3" y="13" width="18" height="7"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  rocket:
    '<path d="M14.5 4.5c3-1 5 1 5 1s2 2 1 5l-6 6-6-6 6-6Z"/><circle cx="15" cy="9" r="1.5"/><path d="M8.5 11.5 5 12l-2 3 4 .5M12.5 15.5 12 19l-3 2-.5-4"/>',
  puzzle:
    '<path d="M9 3h4v3a2 2 0 1 0 4 0V3h4v6h-3a2 2 0 1 0 0 4h3v8h-6v-3a2 2 0 1 0-4 0v3H3v-6h3a2 2 0 1 0 0-4H3V3h6Z"/>',
};
---

<PosterSection
  id="experience"
  number="02"
  rail="Architecture"
  eyebrow="Engineering track record"
  title="Built at scale. Shipped end-to-end."
  subtitle="Open-source Bitcoin work at Angor.io, backend & DevOps at eBay, and three years building full-stack platforms and automation for a national governance body."
>
  <ol class="mt-12 border-t border-cream/15">
    {
      profile.experience.map((job, i) => (
        <li class="group grid gap-4 border-b border-cream/15 py-8 sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-8">
          <div class="flex items-baseline gap-3 sm:block">
            <span class="numeral text-5xl transition-colors group-hover:text-terra">{String(i + 1).padStart(2, "0")}</span>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-cream-subtle sm:mt-3">{job.period}</p>
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-3xl tracking-wide sm:text-4xl">{job.company}</h3>
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-terra">
                {job.role} · {job.location}
              </p>
            </div>
            <p class="mt-2 text-cream-muted">{job.summary}</p>
            <ul class="mt-4 space-y-1.5 text-sm text-cream-muted">
              {job.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-crimson" aria-hidden="true" />
                  {h}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {job.stack.map((t) => (
                <span class="border border-cream/15 px-2 py-0.5 font-mono text-[11px] text-cream-muted">{t}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
    {
      profile.education.map((ed) => (
        <li class="grid gap-4 border-b border-dashed border-cream/15 py-8 sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-cream-subtle">{ed.period}</p>
          <div>
            <h3 class="font-display text-2xl tracking-wide">
              {ed.degree} <span class="text-cream-subtle">· {ed.institution}</span>
            </h3>
            <p class="mt-1 text-sm text-cream-muted">{ed.notes}</p>
          </div>
        </li>
      ))
    }
  </ol>
</PosterSection>

<PosterSection
  id="services"
  surface="paper"
  eyebrow="Commissions open · Work with me"
  title="Productized remote services."
  subtitle="Fixed-scope engagements for founders and teams who need senior hands without the hiring cycle."
>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      profile.services.map((svc, i) => (
        <div class="poster-frame on-paper flex flex-col bg-paper-warm p-6 transition-transform hover:-translate-y-1">
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center bg-cobalt text-paper-warm">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[svc.icon] ?? ""}
              />
            </span>
            <span class="font-serif text-3xl font-bold italic text-crimson">0{i + 1}</span>
          </div>
          <h3 class="mt-6 font-display text-3xl leading-none tracking-wide text-paper-ink">{svc.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper-muted">{svc.description}</p>
          <ul class="mt-5 space-y-2 border-t border-paper-ink/15 pt-5 text-sm text-paper-ink">
            {svc.deliverables.map((d) => (
              <li class="flex gap-2.5">
                <span class="font-bold text-cobalt" aria-hidden="true">
                  ✓
                </span>
                {d}
              </li>
            ))}
          </ul>
          <a href="#hire" class="mt-auto pt-6 font-mono text-xs font-medium uppercase tracking-[0.14em] text-cobalt underline-offset-4 hover:underline">
            Start a project →
          </a>
        </div>
      ))
    }
  </div>
</PosterSection>
