---
import profile from "../../data/profile.json";
const links = [
  { href: "#products", label: "Products" },
  { href: "#experience", label: "Experience" },
  { href: "#services", label: "Services" },
  { href: "#lab", label: "Creative Lab" },
  { href: "#widget", label: "Widget" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3">
  <nav
    class="mx-auto mt-3 flex max-w-6xl items-center justify-between rounded-full border border-white/[0.07] bg-ink-950/70 px-4 py-2 backdrop-blur-xl sm:px-5"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center gap-2 text-sm font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="22" height="22" class="rounded-md" />
      <span>{profile.name}</span>
    </a>
    <ul class="hidden items-center gap-6 text-sm text-fg-muted md:flex">
      {links.map((l) => <li><a href={l.href} class="transition hover:text-fg">{l.label}</a></li>)}
    </ul>
    <a href="#hire" class="rounded-full bg-fg px-3.5 py-1.5 text-xs font-semibold text-ink-950 transition hover:bg-white">Hire me</a>
  </nav>
</header>
