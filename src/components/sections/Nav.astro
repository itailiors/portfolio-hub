---
import Monogram from "../Monogram.astro";
const links = [
  { href: "#products", label: "Products" },
  { href: "#experience", label: "Architecture" },
  { href: "#services", label: "Services" },
  { href: "#lab", label: "Co-op" },
  { href: "#widget", label: "Widget" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-cream/10 bg-night/85 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Primary">
    <a href="#top" class="flex items-center gap-2.5 text-cream" aria-label="Itai Lior — home">
      <Monogram size={34} />
      <span class="hidden font-mono text-[11px] uppercase tracking-[0.18em] text-cream-muted sm:inline">Software &amp; Jazz Co-op</span>
    </a>
    <ul class="hidden items-center gap-7 font-mono text-[11px] uppercase tracking-[0.14em] text-cream-muted md:flex">
      {links.map((l) => <li><a href={l.href} class="transition hover:text-cream">{l.label}</a></li>)}
    </ul>
    <a href="#hire" class="btn-crimson px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em]">Hire me</a>
  </nav>
</header>
