---
import profile from "../../data/profile.json";
import Monogram from "../Monogram.astro";
import { withBase } from "../../lib/url";

const { contact } = profile;
const socials = [
  { label: "GitHub", href: contact.github },
  { label: "LinkedIn", href: contact.linkedin },
  { label: "itch.io", href: contact.itch },
  { label: "YouTube", href: contact.youtube },
  { label: "Instagram", href: contact.instagram },
].filter((s) => s.href);
const bookHref = contact.calendly || `mailto:${contact.email}?subject=Project%20inquiry`;
---

<section id="hire" class="relative pb-12 pt-20 sm:pt-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Hire poster -->
    <div class="poster-frame relative overflow-hidden bg-crimson px-6 py-14 text-[#fff8ec] sm:px-12 sm:py-20">
      <svg class="pointer-events-none absolute inset-y-0 right-0 hidden h-full md:block" viewBox="0 0 150 300" preserveAspectRatio="xMaxYMid meet" aria-hidden="true">
        <defs><clipPath id="hire-disc"><path d="M150 0 A150 150 0 0 0 150 300 Z" /></clipPath></defs>
        <path d="M150 0 A150 150 0 0 0 150 300 Z" fill="#0E0D0C" />
        <g clip-path="url(#hire-disc)">
          <rect x="40" y="70" width="110" height="14" fill="#E85D1A" />
          <rect x="20" y="104" width="130" height="6" fill="#F2EBDD" />
          <rect x="0" y="140" width="150" height="18" fill="#E85D1A" />
          <rect x="20" y="186" width="130" height="6" fill="#F2EBDD" />
          <rect x="40" y="214" width="110" height="12" fill="#E85D1A" />
        </g>
      </svg>
      <div class="relative max-w-2xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#fff8ec]">Remote contracts · MVPs · Extensions</p>
        <h2 class="mt-4 font-display text-5xl leading-[0.9] tracking-wide sm:text-7xl">
          Have a product to ship?<br />
          <span class="font-serif text-4xl font-bold normal-case italic tracking-normal sm:text-6xl">Let's build it.</span>
        </h2>
        <p class="mt-5 max-w-xl text-[#fff8ec]/90">
          Tell me what you're building and where you're stuck. I usually reply within 24 hours with a scope, a timeline and a fixed quote.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={bookHref} class="inline-flex items-center justify-center gap-2 bg-night px-6 py-3.5 text-sm font-semibold text-cream transition hover:bg-char-2">
            {contact.calendly ? "Book a 20-min intro call" : "Email me about a project"} →
          </a>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center justify-center break-all border border-[#fff8ec]/60 px-6 py-3.5 font-mono text-sm transition hover:bg-[#fff8ec]/10">
            {contact.email}
          </a>
        </div>
      </div>
    </div>

    <!-- Gallery stamp footer -->
    <footer class="mt-16 border-t-2 border-cream/80 pt-6">
      <div class="grid gap-6 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center sm:gap-8">
        <Monogram size={96} class="text-cream" />
        <p class="max-w-3xl font-serif text-base italic leading-relaxed text-cream-muted sm:text-lg">
          A co-op is a room where everyone plays. I build software the same way I learned to play jazz — listen to the room, respect the
          form, then improvise until the thing actually swings. Backends that hold the beat; products that make people lean in.
        </p>
      </div>
      <div class="mt-8 flex flex-col gap-4 border-t border-cream/15 pt-5 font-mono text-[11px] uppercase tracking-[0.12em] text-cream-subtle sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} {profile.name} // Software &amp; Jazz Co-op</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" class="transition hover:text-cream">
                  {s.label}
                </a>
              </li>
            ))
          }
          <li><a href={withBase("/ecosystem.json")} class="normal-case transition hover:text-cream">ecosystem.json</a></li>
        </ul>
      </div>
    </footer>
  </div>
</section>
