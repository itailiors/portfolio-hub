---
import profile from "../../data/profile.json";
import JazzPosterArt from "../JazzPosterArt";
---

<section id="top" class="relative pb-16 pt-24 sm:pt-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- masthead line -->
    <p class="animate-fade-up border-y border-cream/15 py-2 text-center font-mono text-[10px] uppercase tracking-[0.2em] text-cream-muted sm:text-[11px]">
      Itai Lior <span class="text-crimson">//</span> Software &amp; Jazz Co-op <span class="hidden sm:inline">— Est. in code, built worldwide</span>
    </p>

    <div class="poster-frame mt-8 grid gap-10 bg-char/60 p-5 sm:p-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-12 lg:p-12">
      <div class="flex min-w-0 flex-col">
        <a href="#hire" class="animate-fade-up inline-flex w-fit items-center gap-2 border border-stage bg-stage/40 px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.12em] text-cream">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-terra opacity-70"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-terra"></span>
          </span>
          {profile.availability}
        </a>

        <h1 class="animate-fade-up mt-7" style="animation-delay:80ms">
          <span class="block font-display text-[60px] leading-[0.86] tracking-wide text-cream sm:text-[88px] lg:text-[104px]">
            Full-Stack<br />Product<br />Engineer
          </span>
          <span class="relative -mt-2 block pl-1 font-serif text-[40px] font-bold italic leading-none text-crimson sm:-mt-4 sm:text-[64px] lg:text-[76px]">
            &amp; Indie Maker.
          </span>
        </h1>

        <p class="animate-fade-up mt-7 max-w-xl text-lg leading-relaxed text-cream-muted" style="animation-delay:160ms">
          {profile.positioning}
        </p>

        <div class="animate-fade-up mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:240ms">
          <a href="#products" class="btn-crimson group px-6 py-3.5 text-sm">
            Explore Live Products <span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">↓</span>
          </a>
          <a href="#hire" class="btn-ghost group px-6 py-3.5 text-sm">
            Hire Me for Remote Contracts / MVPs <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="animate-fade-up mt-auto grid grid-cols-1 gap-px border border-cream/15 bg-cream/15 pt-0 font-mono text-[11px] uppercase tracking-[0.08em] sm:grid-cols-2 lg:mt-10" style="animation-delay:320ms" aria-label="Credentials">
          {
            profile.credibility.map((c, i) => (
              <li class="flex items-center gap-3 bg-char px-3 py-2.5 text-cream-muted">
                <span class="font-serif text-sm normal-case italic text-crimson">0{i + 1}</span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="animate-fade-up mx-auto w-full max-w-[420px] lg:max-w-none" style="animation-delay:200ms">
        <div class="poster-frame bg-night p-2.5">
          <JazzPosterArt variant="hero" className="block h-auto w-full" label="Bauhaus jazz poster: orange half disc, red and cream equalizer bars, and a cobalt ink drawing of a jazz club facade" />
        </div>
        <figcaption class="mt-3 flex justify-between font-mono text-[10px] uppercase tracking-[0.16em] text-cream-subtle">
          <span>Plate I — Session in Eight Bars</span>
          <span>SVG / 2026</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
