---
import profile from "../../data/profile.json";
import ecosystem from "../../../public/ecosystem.json";
import PosterSection from "./PosterSection.astro";
import JazzPosterArt from "../JazzPosterArt";

const { creative } = profile;
const featured = ecosystem.products.find((p) => p.id === "bet-on-dave");
---

<PosterSection
  id="lab"
  number="03"
  rail="Creative Co-op"
  eyebrow="The Creative Lab"
  title="Where the side quests live."
  subtitle="Game jams, music and the experiments that keep the product instincts sharp."
>
  <div class="mt-12 grid gap-5 md:grid-cols-6">
    <!-- Featured game -->
    <a
      href={featured?.ctaUrl ?? "https://itch.io/"}
      target="_blank"
      rel="noopener noreferrer"
      class="poster-frame card-night group flex flex-col md:col-span-4 md:row-span-2"
    >
      <div class="overflow-hidden border-b border-cream/10">
        <JazzPosterArt variant="card" motif="slant" seed="bet-on-dave-lab" className="block aspect-[16/8] w-full" label="Chaotic slanted geometric artwork for Bet on Dave" />
      </div>
      <div class="flex flex-1 flex-col p-6">
        <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-terra">Featured · {featured?.statusBadge}</span>
        <h3 class="mt-2 font-display text-4xl leading-none tracking-wide sm:text-5xl">{featured?.name}</h3>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-cream-muted">{featured?.consumerDescription}</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {featured?.engineeringSpecs.stack.map((t) => (
            <span class="border border-cream/15 px-2 py-0.5 font-mono text-[11px] text-cream-muted">{t}</span>
          ))}
        </div>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-6 font-mono text-xs uppercase tracking-[0.14em] text-cream">
          {featured?.ctaText} <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
        </span>
      </div>
    </a>

    <!-- Venue nod: gallery-print card with cobalt ink -->
    <div class="poster-frame on-paper flex flex-col bg-paper-warm p-6 text-paper-ink md:col-span-2 md:row-span-2">
      <p class="eyebrow on-paper">Late sets · House bands</p>
      <svg viewBox="0 0 200 110" class="mt-4 h-auto w-full" aria-hidden="true" fill="none" stroke="#1B4596" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 104 L196 84" />
        <path d="M30 100 V30 H150 V88" />
        <path d="M24 60 C50 50 80 66 106 56 S150 50 162 56 V68 C140 62 112 76 88 68 S44 70 24 74 Z" />
        <path d="M44 98 V76 H64 V96" />
        <path d="M86 78 h48 v16 h-48 z" />
        <path d="M120 30 L150 8" />
        <path d="M126 26 L148 10 L154 34 L132 50 Z" fill="#1B4596" />
        <path d="M140 38 V28 l6 -3" stroke="#F6EAC2" />
        <circle cx="138.5" cy="38" r="2" fill="#F6EAC2" stroke="none" />
        <path d="M172 98 V64 M172 64 c-8 -2 -8 -14 0 -16 c0 -10 14 -10 14 0 c8 2 8 14 0 16 z" />
      </svg>
      <h3 class="mt-4 font-display text-3xl leading-none tracking-wide">{creative.venues.title}</h3>
      <p class="mt-3 text-sm leading-relaxed text-paper-muted">{creative.venues.note}</p>
      <ul class="mt-auto space-y-3 border-t border-paper-ink/15 pt-4">
        {
          creative.venues.places.map((v) => (
            <li>
              <p class="font-semibold text-cobalt">{v.name}</p>
              {(v.city || v.detail) && (
                <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-paper-muted">
                  {[v.city, v.detail].filter(Boolean).join(" · ")}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Bio -->
    <div class="poster-frame card-night p-6 md:col-span-3">
      <p class="eyebrow">Off the keyboard</p>
      <p class="mt-3 font-serif text-xl italic leading-snug text-cream">“{creative.bio}”</p>
      <div class="mt-5 flex flex-wrap gap-2 font-mono text-[11px] uppercase tracking-[0.1em]">
        <a href={profile.contact.youtube} target="_blank" rel="noopener noreferrer" class="border border-cream/25 px-2.5 py-1 text-cream-muted transition hover:border-cream hover:text-cream">YouTube ↗</a>
        <a href={profile.contact.instagram} target="_blank" rel="noopener noreferrer" class="border border-cream/25 px-2.5 py-1 normal-case text-cream-muted transition hover:border-cream hover:text-cream">@it.is.lio ↗</a>
      </div>
    </div>

    <!-- Game jams list -->
    <div class="poster-frame card-night p-6 md:col-span-3">
      <p class="eyebrow">Game Jams</p>
      <ul class="mt-3 divide-y divide-cream/10">
        {
          creative.gameJams.map((g) => (
            <li class="flex items-center gap-3">
              <a href={g.url} target="_blank" rel="noopener noreferrer" class="flex min-w-0 flex-1 items-center justify-between gap-3 py-2.5 text-sm transition hover:text-terra">
                <span class="min-w-0">
                  <span class="block truncate font-medium">{g.title}</span>
                  <span class="block font-mono text-[11px] text-cream-subtle">
                    {g.jam} · {g.note}
                  </span>
                </span>
                <span class="text-cream-subtle" aria-hidden="true">
                  ↗
                </span>
              </a>
              {"soundtrack" in g && g.soundtrack && (
                <a
                  href={g.soundtrack}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 border border-cream/25 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-cream-muted transition hover:border-cream hover:text-cream"
                  aria-label={`${g.title} soundtrack on YouTube`}
                >
                  OST ▶
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Music corner: real sessions behind a click-to-play facade (no YouTube JS until clicked) -->
    <div class="poster-frame card-night p-6 md:col-span-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Music corner · Recent sessions</p>
          <p class="mt-2 font-display text-3xl tracking-wide">{creative.instruments.join(" · ")}</p>
        </div>
        <a
          href={profile.contact.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-cream/25 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-cream-muted transition hover:border-cream hover:text-cream"
        >
          All sessions on YouTube ↗
        </a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {
          creative.sessions.map((s) => (
            <figure class="m-0 min-w-0">
              <button
                type="button"
                class="yt-facade group relative block aspect-video w-full overflow-hidden border border-cream/15 bg-night"
                data-yt={s.youtubeId}
                data-title={`${s.title} — ${s.note}`}
                aria-label={`Play ${s.title} (${s.note})`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${s.youtubeId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover opacity-75 transition group-hover:opacity-100"
                />
                <span class="absolute left-1/2 top-1/2 grid h-12 w-12 -translate-x-1/2 -translate-y-1/2 place-items-center bg-crimson text-[#fff8ec] transition group-hover:scale-110" aria-hidden="true">
                  ▶
                </span>
              </button>
              <figcaption class="mt-2 flex items-baseline justify-between gap-3">
                <span class="font-display text-2xl tracking-wide">{s.title}</span>
                <span class="truncate font-mono text-[11px] text-cream-subtle">{s.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</PosterSection>

<script>
  // Swap a session thumbnail for the real player only when the visitor asks for it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".yt-facade")) {
    btn.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1`;
        iframe.title = btn.dataset.title ?? "YouTube video";
        iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.className = "block aspect-video w-full border border-cream/15";
        btn.replaceWith(iframe);
      },
      { once: true },
    );
  }
</script>
