---
import profile from "../../data/profile.json";
import ecosystem from "../../../public/ecosystem.json";
import PosterSection from "./PosterSection.astro";
import JazzPosterArt from "../JazzPosterArt";

const { creative } = profile;
const paraglider = ecosystem.products.find((p) => p.id === "paraglider");
const instrumentColor: Record<string, string> = { piano: "#D9231A", drums: "#E85D1A", guitar: "#1B4596" };
---

<PosterSection
  id="lab"
  number="03"
  rail="Creative Co-op"
  eyebrow="The Creative Lab"
  title="Where the side quests live."
  subtitle="Game jams, music and the experiments that keep the product instincts sharp."
>
  <div class="mt-12 grid gap-5 md:grid-cols-6">
    <!-- Featured game -->
    <a
      href={paraglider?.ctaUrl ?? "https://itch.io/"}
      target="_blank"
      rel="noopener noreferrer"
      class="poster-frame card-night group flex flex-col md:col-span-4 md:row-span-2"
    >
      <div class="overflow-hidden border-b border-cream/10">
        <JazzPosterArt variant="card" seed="paraglider-lab" accent="#E85D1A" className="block aspect-[16/8] w-full" label="Geometric artwork for the paraglider game" />
      </div>
      <div class="flex flex-1 flex-col p-6">
        <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-terra">Featured · {paraglider?.statusBadge}</span>
        <h3 class="mt-2 font-display text-4xl leading-none tracking-wide sm:text-5xl">{paraglider?.name}</h3>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-cream-muted">{paraglider?.consumerDescription}</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {paraglider?.engineeringSpecs.stack.map((t) => (
            <span class="border border-cream/15 px-2 py-0.5 font-mono text-[11px] text-cream-muted">{t}</span>
          ))}
        </div>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-6 font-mono text-xs uppercase tracking-[0.14em] text-cream">
          Play on itch.io <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
        </span>
      </div>
    </a>

    <!-- Venue nod: gallery-print card with cobalt ink -->
    <div class="poster-frame on-paper flex flex-col bg-paper-warm p-6 text-paper-ink md:col-span-2 md:row-span-2">
      <p class="eyebrow on-paper">Late sets · House bands</p>
      <svg viewBox="0 0 200 110" class="mt-4 h-auto w-full" aria-hidden="true" fill="none" stroke="#1B4596" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 104 L196 84" />
        <path d="M30 100 V30 H150 V88" />
        <path d="M24 60 C50 50 80 66 106 56 S150 50 162 56 V68 C140 62 112 76 88 68 S44 70 24 74 Z" />
        <path d="M44 98 V76 H64 V96" />
        <path d="M86 78 h48 v16 h-48 z" />
        <path d="M120 30 L150 8" />
        <path d="M126 26 L148 10 L154 34 L132 50 Z" fill="#1B4596" />
        <path d="M140 38 V28 l6 -3" stroke="#F6EAC2" />
        <circle cx="138.5" cy="38" r="2" fill="#F6EAC2" stroke="none" />
        <path d="M172 98 V64 M172 64 c-8 -2 -8 -14 0 -16 c0 -10 14 -10 14 0 c8 2 8 14 0 16 z" />
      </svg>
      <h3 class="mt-4 font-display text-3xl leading-none tracking-wide">{creative.venues.title}</h3>
      <p class="mt-3 text-sm leading-relaxed text-paper-muted">{creative.venues.note}</p>
      <ul class="mt-auto space-y-3 border-t border-paper-ink/15 pt-4">
        {
          creative.venues.places.map((v) => (
            <li>
              <p class="font-semibold text-cobalt">{v.name}</p>
              <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-paper-muted">
                {v.city} · {v.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Bio -->
    <div class="poster-frame card-night p-6 md:col-span-3">
      <p class="eyebrow">Off the keyboard</p>
      <p class="mt-3 font-serif text-xl italic leading-snug text-cream">“{creative.bio}”</p>
    </div>

    <!-- Game jams list -->
    <div class="poster-frame card-night p-6 md:col-span-3">
      <p class="eyebrow">Game Jams</p>
      <ul class="mt-3 divide-y divide-cream/10">
        {
          creative.gameJams.map((g) => (
            <li>
              <a href={g.url} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-3 py-2.5 text-sm transition hover:text-terra">
                <span class="min-w-0">
                  <span class="block truncate font-medium">{g.title}</span>
                  <span class="block font-mono text-[11px] text-cream-subtle">
                    {g.jam} · {g.hours}h
                  </span>
                </span>
                <span class="text-cream-subtle" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Music corner -->
    {
      creative.instruments.map((inst) => (
        <div class="poster-frame card-night flex flex-col md:col-span-2">
          {inst.youtubeId ? (
            <iframe
              class="aspect-video w-full"
              src={`https://www.youtube-nocookie.com/embed/${inst.youtubeId}`}
              title={`${inst.name} — ${inst.caption}`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <div class="relative grid aspect-video w-full place-items-center overflow-hidden bg-night">
              <span class="absolute inset-y-0 left-0 w-1/3" style={`background:${instrumentColor[inst.id] ?? "#D9231A"}`} aria-hidden="true" />
              <span class="absolute bottom-0 left-1/3 right-0 h-1/3 bg-char-3" aria-hidden="true" />
              <span class="relative grid h-12 w-12 place-items-center border border-cream/40 bg-night text-cream" aria-hidden="true">
                ▶
              </span>
              <span class="absolute bottom-2 right-3 font-mono text-[10px] uppercase tracking-[0.1em] text-cream-subtle">YouTube placeholder</span>
            </div>
          )}
          <div class="flex items-baseline justify-between gap-3 p-4">
            <p class="font-display text-2xl tracking-wide">{inst.name}</p>
            <p class="truncate font-mono text-[11px] text-cream-subtle">{inst.caption}</p>
          </div>
        </div>
      ))
    }
  </div>
</PosterSection>
