---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<div class="max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-base leading-relaxed text-fg-muted">{subtitle}</p>}
</div>
