---
/** Include once on any page that renders VideoCard: swaps a thumbnail for the player on click. */
---

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".hub-video .yt-facade")) {
    btn.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1`;
        iframe.title = btn.dataset.title ?? "YouTube video";
        iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        const frame = document.createElement("div");
        frame.className = "hub-media";
        frame.append(iframe);
        btn.replaceWith(frame);
      },
      { once: true },
    );
  }
</script>
