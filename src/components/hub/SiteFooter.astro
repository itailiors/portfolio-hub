---
import profile from "../../data/profile.json";
import { withBase } from "../../lib/url";

const { contact } = profile;
const instruments = profile.creative.instruments.map((i) => i.toLowerCase());
const played = `${instruments.slice(0, -1).join(", ")} and ${instruments.at(-1)}`;
const links = [
  { label: "GitHub", href: contact.github },
  { label: "itch.io", href: contact.itch },
  { label: "YouTube · Apps", href: contact.youtubeApps },
  { label: "YouTube · Games", href: contact.youtubeGames },
].filter((l) => l.href);
---

<footer class="mx-auto mt-24 max-w-7xl px-4 pb-12 sm:px-6">
  <p class="text-center font-hand text-lg text-cream-muted">
    * everything here is built by one maker who plays {played} <a href={withBase("/about/")} class="text-cream underline decoration-terra decoration-2 underline-offset-4 hover:text-terra">late at night</a>.
  </p>
  <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-cream/15 pt-5 font-mono text-[11px] uppercase tracking-[0.12em] text-cream-subtle sm:flex-row">
    <p>© {new Date().getFullYear()} {profile.name} // Software &amp; Jazz</p>
    <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="transition hover:text-cream">
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={withBase("/about/#hire")} class="transition hover:text-cream">Hire me</a></li>
      <li><a href={withBase("/ecosystem.json")} class="normal-case transition hover:text-cream">ecosystem.json</a></li>
    </ul>
  </div>
</footer>
