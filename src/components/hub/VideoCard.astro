---
/**
 * Click-to-play YouTube card. Shows the thumbnail; the youtube-nocookie player is only
 * created when the visitor clicks (see the script in VideoScript.astro, included once per page).
 */
import type { Video } from "../../lib/youtube";

interface Props {
  video: Video;
}
const { video: v } = Astro.props;
const date = new Date(v.published).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<figure class="hub-video min-w-0">
  <button
    type="button"
    class="hub-media yt-facade group block w-full cursor-pointer"
    data-yt={v.id}
    data-title={v.title}
    aria-label={`Play video: ${v.title}`}
  >
    <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <span class="absolute inset-0 grid place-items-center bg-black/25 transition group-hover:bg-black/10">
      <span class="grid h-14 w-14 place-items-center rounded-full bg-[#d9231a] text-xl text-white shadow-lg transition group-hover:scale-110" aria-hidden="true">▶</span>
    </span>
    {v.isShort && <span class="absolute left-2 top-2 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-white">Short</span>}
  </button>
  <figcaption class="mt-3">
    <p class="font-semibold leading-snug" dir="auto">{v.title}</p>
    <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.1em] text-cream-subtle">
      {date} · <a href={v.isShort ? `https://www.youtube.com/shorts/${v.id}` : `https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="hover:text-cream">YouTube ↗</a>
    </p>
  </figcaption>
</figure>
